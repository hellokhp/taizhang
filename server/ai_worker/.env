# 本地运行配置（本文件不进代码库，已由根目录 .gitignore 忽略）
# 由 .env.example 复制而来，模板中的占位符已替换为真实值。
# ⚠️ 修改本文件后必须重启 Worker：CONFIG 在进程启动时固化，热改不生效。

# ===================== 模型供应商（一键切换） =====================
LLM_PROVIDER=dashscope
# LLM_VISION_PROVIDER=dashscope

# ---- 千问（DashScope OpenAI 兼容模式，默认）----
DASHSCOPE_API_KEY=sk-ws-H.YLRRRXY.JDjd.MEYCIQC_z99I7F9omWeNMk0anQI-2jOHnUqZX9z086yzV1_rGAIhAK2VCugaWREgiejkAgSrDLWuzdVdt5Aps6fbfoialJKL
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEXT_MODEL=qwen-plus
LLM_VISION_MODEL=qwen3-vl-plus

# ---- 切到 DeepSeek 时（把上方 LLM_PROVIDER 改为 deepseek，并解除下面注释）----
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
# LLM_TEXT_MODEL=deepseek-chat
# LLM_VISION_PROVIDER=dashscope
# DASHSCOPE_API_KEY=CHANGE_ME_DASHSCOPE_API_KEY

# ---- WorkBuddy / 任意 OpenAI 兼容网关（custom）----
# LLM_PROVIDER=workbuddy
# LLM_BASE_URL=https://<workbuddy-gateway>/v1
# LLM_API_KEY=CHANGE_ME_WORKBUDDY_API_KEY
# LLM_TEXT_MODEL=<workbuddy-提供的模型名>
# LLM_VISION_PROVIDER=dashscope

# PostgreSQL（与后端 3.8 主进程同一套）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=admin123.
PG_DB=yadecai

# 文件存储根目录（与后端 fs.init_fs 一致），blob 与物化临时目录都在这里
STORAGE_ROOT=

# Redis 信号层（可丢；不填则 Worker 与 SSE 自动降级为轮询）
REDIS_URL=redis://127.0.0.1:6379/0

# Worker 行为
AI_WORKER_ID=w1
AI_CONCURRENCY=6
AI_HEARTBEAT_STALE=300
AI_MAX_ATTEMPTS=3
