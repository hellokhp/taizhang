# 复制为 .env 并填入真实值；生产环境建议用 supervisor environment 注入，不落文件
# ⚠️ 本文件只放占位符，真实密钥绝不进代码库

# ===================== 模型供应商（一键切换） =====================
# LLM_PROVIDER 可选：dashscope(默认/千问) | deepseek | openai | workbuddy | <自定义名>
#   不填 = dashscope，行为与旧版完全一致（向后兼容）。
# LLM_VISION_PROVIDER 可选：默认跟随 LLM_PROVIDER。
#   典型组合：LLM_PROVIDER=deepseek + LLM_VISION_PROVIDER=dashscope
#   （DeepSeek 纯文本、无视觉能力，公示截图/扫描转写需另配视觉供应商）
#
# 切换优先级（文本/视觉各自独立）：
#   ① LLM_BASE_URL / LLM_API_KEY / LLM_TEXT_MODEL（或 _VISION_ 系列）显式覆盖
#   ② 否则取预设供应商的 base_url / api_key_env / 默认模型
LLM_PROVIDER=dashscope
# LLM_VISION_PROVIDER=dashscope

# ---- 千问（DashScope OpenAI 兼容模式，默认）----
DASHSCOPE_API_KEY=CHANGE_ME_DASHSCOPE_API_KEY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEXT_MODEL=qwen-plus
LLM_VISION_MODEL=qwen3-vl-plus

# ---- 切到 DeepSeek 时（把上方 LLM_PROVIDER 改为 deepseek，并解除下面注释）----
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
# LLM_TEXT_MODEL=deepseek-chat
# LLM_VISION_PROVIDER=dashscope        # 视觉仍用千问 VL
# DASHSCOPE_API_KEY=CHANGE_ME_DASHSCOPE_API_KEY

# ---- WorkBuddy / 任意 OpenAI 兼容网关（custom）----
# 若 WorkBuddy 提供 OpenAI 兼容端点，按下面填即可，无需改代码：
# LLM_PROVIDER=workbuddy
# LLM_BASE_URL=https://<workbuddy-gateway>/v1
# LLM_API_KEY=CHANGE_ME_WORKBUDDY_API_KEY
# LLM_TEXT_MODEL=<workbuddy-提供的模型名>
# LLM_VISION_PROVIDER=dashscope        # 若 WorkBuddy 也无视觉，则视觉另配

# PostgreSQL（与后端 3.8 主进程同一套）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DB=yadecai

# 文件存储根目录（与后端 fs.init_fs 一致），blob 与物化临时目录都在这里
STORAGE_ROOT=

# Redis 信号层（可丢；不填则 Worker 与 SSE 自动降级为轮询）
# 生产必须 requirepass + bind 127.0.0.1 + 独立 db
REDIS_URL=redis://127.0.0.1:6379/0

# Worker 行为
AI_WORKER_ID=w1
AI_CONCURRENCY=6
AI_HEARTBEAT_STALE=300
AI_MAX_ATTEMPTS=3
