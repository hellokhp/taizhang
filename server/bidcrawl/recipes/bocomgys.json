      "body": {
        "newsId": "{newsId}"
      },
      "method": "POST",
      "headers": {
        "Accept": "application/json",
        "Origin": "https://bocom-gys.bankcomm.com",
        "Referer": "https://bocom-gys.bankcomm.com/espuser/register/noticeDetail",
        "mgmToken": "null",
        "esp-token": "null",
        "mgm-token": "null",
        "sec-ch-ua": "\"Not-A.Brand\";v=\"99\", \"Microsoft Edge\";v=\"157\", \"Chromium\";v=\"157\"",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36 Edg/157.0.0.0",
        "Content-Type": "application/json; charset=utf-8",
        "Sec-Fetch-Dest": "empty",
        "Sec-Fetch-Mode": "cors",
        "Sec-Fetch-Site": "same-origin",
        "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6",
        "sec-ch-ua-mobile": "?0",
        "sec-ch-ua-platform": "\"Windows\""
      }
    },
    "id_field": "external_id",
    "row_path": "$.data.espNews",
    "attachments": {
